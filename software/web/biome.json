{
  "root": true,
  "files": {
    "includes": [
      "**/*.mjs",
      "**/*.json",
      "public/**/*.html",
      "public/**/*.css",
      "!package-lock.json",
      "!src/vendor/**",
      "!build-lock.json",
      "!test-results/**",
      "!test-results-hardware/**",
      "!test-results-hosted/**",
      "!test-results-mobile/**",
      "!playwright-report/**"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 110,
    "enabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "none"
    }
  },
  "linter": {
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnreachable": "error",
        "noUndeclaredVariables": "error"
      },
      "suspicious": {
        "noDoubleEquals": "error",
        "noDuplicateCase": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noAsyncPromiseExecutor": "error"
      },
      "style": {
        "noNestedTernary": "error",
        "noMultiAssign": "error",
        "useBlockStatements": "error",
        "useSingleVarDeclarator": "error"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "whitespaceSensitivity": "ignore"
    }
  }
}
